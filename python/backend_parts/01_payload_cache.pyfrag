# Reuses verified bootstrap payloads across remote shells without caching tokens or application data.
_PAYLOAD_CACHE_LIMIT = 1024 * 1024
_FEATURE_LOAD_LOCK = threading.Lock()


def _backend_cache_path(kind):
    """Returns a bounded capability cache slot in a private per-user temporary directory."""
    import stat
    import tempfile

    if kind not in ("core", "feature", "grid", "schema", "inspection", "query", "models", "commit", "execution", "extras"):
        raise ValueError("Unknown backend payload cache slot.")
    root = os.path.join(tempfile.gettempdir(), "django-shell-backend-" + str(getattr(os, "getuid", lambda: "user")()))
    os.makedirs(root, mode=0o700, exist_ok=True)
    info = os.lstat(root)
    if not stat.S_ISDIR(info.st_mode) or (os.name == "posix" and (info.st_uid != os.getuid() or info.st_mode & 0o077)):
        raise OSError("Backend payload cache directory is not private.")
    return os.path.join(root, kind + ".b64")


def _backend_cache_read(kind, digest):
    """Reads only bounded regular files whose bytes match the extension's exact payload digest."""
    import hashlib
    import stat

    if not isinstance(digest, str) or len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest):
        return None
    try:
        flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(_backend_cache_path(kind), flags)
        with os.fdopen(descriptor, "rb") as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size > _PAYLOAD_CACHE_LIMIT:
                return None
            data = stream.read(_PAYLOAD_CACHE_LIMIT + 1)
        if len(data) <= _PAYLOAD_CACHE_LIMIT and hashlib.sha256(data).hexdigest() == digest:
            return data.decode("ascii")
    except (OSError, ValueError, UnicodeError):
        pass
    return None


def _backend_cache_write(kind, data):
    """Atomically replaces a cache slot; unavailable or read-only storage never prevents attachment."""
    import tempfile

    temporary = None
    try:
        if not isinstance(data, str) or not data or len(data) > _PAYLOAD_CACHE_LIMIT:
            return
        encoded = data.encode("ascii")
        target = _backend_cache_path(kind)
        with tempfile.NamedTemporaryFile(dir=os.path.dirname(target), prefix=".payload-", delete=False) as stream:
            temporary = stream.name
            stream.write(encoded)
        os.replace(temporary, target)
    except (OSError, ValueError, UnicodeError):
        pass
    finally:
        if temporary is not None:
            try:
                os.unlink(temporary)
            except OSError:
                pass
